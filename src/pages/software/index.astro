---
import Layout from "../../layouts/Layout.astro";
import EmptyCatalog from "../../components/EmptyCatalog.astro";
import AppCard from "../../components/AppCard.astro";
import Icon from "../../components/Icon.astro";
import { apps } from "../../data/apps";
import Text from "../../components/Text.astro";
import { currentLocale, translatedAttribute } from "../../i18n/server";
import { publishedApps } from "../../lib/catalog";
const catalog = publishedApps(apps);
const locale = currentLocale(Astro.url.pathname);
---

<Layout
  titleKey="seo.softwareTitle"
  descriptionKey="catalog.description"
  current="software"
>
  <div class="container page-content">
    <header class="page-heading">
      <Text as="p" class="eyebrow" k="catalog.eyebrow" />
      <Text as="h1" k="catalog.title" />
      <Text as="p" k="catalog.description" />
    </header>
    <section {...translatedAttribute("aria-label", "a11y.published", locale)}>
      {catalog.length > 0 ? (
        <div class="app-grid">
          {catalog.map((app) => (
            <AppCard app={app} />
          ))}
        </div>
      ) : (
        <EmptyCatalog headingLevel="h2" />
      )}
    </section>
    <aside class="catalog-note">
      <div class="soft-icon">
        <Icon name="info" size={22} />
      </div>
      <div>
        <Text as="h2" k="catalog.noteTitle" />
        <Text as="p" k="catalog.note" />
      </div>
    </aside>
  </div>
</Layout>
