---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { withBase } from "../lib/paths";
---

<Layout
  title="Page not found"
  description="This page could not be found. Find your way back to the Muse collection."
  noindex
>
  <section class="container not-found">
    <p class="eyebrow">404 · Page not found</p>
    <h1>A little off the path.</h1>
    <p>
      This page may have moved, or the address may be incomplete. You can find
      your way back to Muse below.
    </p>
    <div class="hero-actions">
      <a class="button button-filled" href={withBase()}>
        Back to home <Icon name="arrow" size={20} />
      </a>
      <a class="button button-outlined" href={withBase("software/")}>
        Browse software
      </a>
    </div>
  </section>
</Layout>
