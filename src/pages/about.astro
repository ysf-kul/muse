---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Text from "../components/Text.astro";
import { currentLocale, localeUrl, translatedAttribute } from "../i18n/server";
const locale = currentLocale(Astro.url.pathname);
---

<Layout
  titleKey="seo.aboutTitle"
  descriptionKey="seo.aboutDescription"
  current="about"
>
  <div class="container page-content">
    <header class="page-heading">
      <Text as="p" class="eyebrow" k="about.eyebrow" />
      <h1>
        <Text k="about.titleFirst" />
        <br />
        <Text k="about.titleSecond" class="headline-accent" />
      </h1>
      <Text as="p" k="about.intro" />
    </header>
    <div class="about-grid">
      <section class="about-story" aria-labelledby="about-heading">
        <Text as="h2" id="about-heading" k="about.heading" />
        <Text as="p" k="about.personal" />
        <Text as="p" k="about.tools" />
        <Text as="p" k="about.aim" />
        <a
          class="button button-filled"
          href={localeUrl("software/", locale)}
          data-route="software/"
        >
          <Text k="about.explore" /> <Icon name="arrow" size={20} />
        </a>
      </section>
      <aside
        class="about-principles"
        {...translatedAttribute("aria-label", "a11y.principles", locale)}
      >
        <Text as="p" class="eyebrow" k="about.guides" />
        <div>
          <Icon name="heart" />
          <Text as="h3" k="about.purposeTitle" />
          <Text as="p" k="about.purpose" />
        </div>
        <div>
          <Icon name="layers" />
          <Text as="h3" k="brand.philosophy" />
          <Text as="p" k="about.design" />
        </div>
        <div>
          <Icon name="code" />
          <Text as="h3" k="about.toolsTitle" />
          <Text as="p" k="about.knowledge" />
        </div>
      </aside>
    </div>
  </div>
</Layout>
