---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import AppCard from "../components/AppCard.astro";
import EmptyCatalog from "../components/EmptyCatalog.astro";
import { apps } from "../data/apps";
import Text from "../components/Text.astro";
import { currentLocale, localeUrl, translatedAttribute } from "../i18n/server";
import { publishedApps } from "../lib/catalog";
const locale = currentLocale(Astro.url.pathname);
const catalog = publishedApps(apps);
const selected = catalog.filter((app) => app.featured);
const featured = selected.length > 0 ? selected : catalog.slice(0, 3);
---

<Layout current="home">
  <section class="container hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="accent-line" aria-hidden="true"></span>
        <Text k="home.eyebrow" />
      </p>
      <h1 id="hero-title">
        <Text k="home.titleFirst" />
        <br />
        <Text k="home.titleSecond" class="headline-accent" />
      </h1>
      <Text as="p" class="hero-slogan" k="brand.slogan" />
      <Text as="p" class="hero-description" k="home.description" />
      <div class="hero-actions">
        <a
          class="button button-filled"
          href={localeUrl("software/", locale)}
          data-route="software/"
        >
          <Text k="home.explore" /> <Icon name="arrow" size={20} />
        </a>
        <a
          class="button button-text"
          href={localeUrl("about/", locale)}
          data-route="about/"
        >
          <Text k="home.about" /> <Icon name="diagonal" size={18} />
        </a>
      </div>
    </div>
    <aside
      class="hero-note"
      {...translatedAttribute("aria-label", "home.approach", locale)}
    >
      <div class="hero-note-top">
        <Text class="eyebrow" k="home.approach" />
        <Icon name="diagonal" size={28} />
      </div>
      <p>
        <Text k="home.noteFirst" /> <br />
        <Text k="home.noteSecond" /> <br />
        <Text k="home.noteThird" class="editorial-accent" />
      </p>
      <div class="hero-note-bottom">
        <span>
          <Text k="home.notePurpose" />
          <br />
          <Text k="home.noteDesign" />
        </span>
        <span class="note-monogram" aria-hidden="true">
          m.
        </span>
      </div>
    </aside>
  </section>
  <div
    class="container values-strip"
    {...translatedAttribute("aria-label", "a11y.values", locale)}
  >
    <span>
      <Icon name="heart" size={18} />
      <Text k="home.independent" />
    </span>
    <span>
      <Icon name="layers" size={18} />
      <Text k="home.sharedDesign" />
    </span>
    <span>
      <Icon name="code" size={18} />
      <Text k="home.aiAssistance" />
    </span>
  </div>
  <section class="container section" aria-labelledby="software-heading">
    <div class="section-heading">
      <div>
        <Text as="p" class="eyebrow" k="home.collection" />
        <Text as="h2" id="software-heading" k="home.collectionTitle" />
      </div>
      <a
        class="text-link"
        href={localeUrl("software/", locale)}
        data-route="software/"
      >
        <Text k="common.allSoftware" /> <Icon name="arrow" size={20} />
      </a>
    </div>
    {featured.length > 0 ? (
      <div class="app-grid">
        {featured.map((app) => (
          <AppCard app={app} />
        ))}
      </div>
    ) : (
      <EmptyCatalog />
    )}
  </section>
  <section
    class="container philosophy-panel"
    aria-labelledby="philosophy-heading"
  >
    <div>
      <Text as="p" class="eyebrow" k="home.commonThread" />
      <h2 id="philosophy-heading">
        <Text k="home.differentApps" />
        <br />
        <Text k="home.oneMuse" class="headline-accent" />
      </h2>
    </div>
    <div class="philosophy-copy">
      <Text as="p" k="home.philosophy" />
      <a
        class="text-link"
        href={localeUrl("about/", locale)}
        data-route="about/"
      >
        <Text k="home.philosophyLink" /> <Icon name="arrow" size={19} />
      </a>
    </div>
  </section>
</Layout>
