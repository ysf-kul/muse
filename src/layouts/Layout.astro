---
import "../styles/tokens.css";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
import Text from "../components/Text.astro";
import {
  messages,
  locales,
  defaultLocale,
  translate,
  languageNames,
  type TranslationKey,
  type LocalizedText,
} from "../i18n/messages";
import { currentLocale, localeUrl, translatedAttribute } from "../i18n/server";
import { pagePath } from "../i18n/routing";
import preferences from "../i18n/preferences.js?raw";
import languageState from "../i18n/language-state.js?raw";
import { withBase } from "../lib/paths";
import { isWebUrl } from "../lib/catalog";
interface Props {
  titleKey?: TranslationKey;
  descriptionKey?: TranslationKey;
  title?: LocalizedText;
  description?: LocalizedText;
  current?: "home" | "software" | "about";
  noindex?: boolean;
}
const {
  title,
  description,
  titleKey = "seo.homeTitle",
  descriptionKey = "brand.description",
  current,
  noindex = false,
} = Astro.props;
const locale = currentLocale(Astro.url.pathname);
const nextLocale = locale === "tr" ? "en" : "tr";
const pageTitle = title ? title[locale] : translate(locale, titleKey);
const route = pagePath(Astro.url.pathname, import.meta.env.BASE_URL);
const json = JSON.stringify(messages).replaceAll("<", "\\u003c");
const titleAttributes = title
  ? { "data-localized": JSON.stringify(title) }
  : { "data-i18n": titleKey };
const titleMeta = title
  ? { content: title[locale], "data-localized-content": JSON.stringify(title) }
  : translatedAttribute("content", titleKey, locale);
const descriptionMeta = description
  ? {
      content: description[locale],
      "data-localized-content": JSON.stringify(description),
    }
  : translatedAttribute("content", descriptionKey, locale);
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const socialImage = Astro.site
  ? new URL(
      withBase(
        `assets/${locale === "tr" ? "social-preview-tr.png" : "social-preview.png"}`,
      ),
      Astro.site,
    )
  : withBase(
      `assets/${locale === "tr" ? "social-preview-tr.png" : "social-preview.png"}`,
    );
const source =
  site.links.source && isWebUrl(site.links.source)
    ? site.links.source
    : undefined;
const contact =
  site.links.contact &&
  (isWebUrl(site.links.contact) ||
    /^mailto:[^\s@]+@[^\s@]+$/.test(site.links.contact))
    ? site.links.contact
    : undefined;
---

<!doctype html>
<html
  lang={locale}
  data-rendered-locale={locale}
  data-supported-locales={JSON.stringify(locales)}
  data-default-locale={defaultLocale}
  data-language-names={JSON.stringify(languageNames)}
  data-base-path={import.meta.env.BASE_URL}
  data-page-path={route}
  data-known-page={noindex ? "false" : "true"}
  data-site-origin={Astro.site?.origin}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" {...descriptionMeta} />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#f8f9f5"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#111714"
      media="(prefers-color-scheme: dark)"
    />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title {...titleAttributes}>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {!noindex && Astro.site && (
      <>
        <link
          rel="alternate"
          hreflang="tr"
          href={new URL(localeUrl(route, "tr"), Astro.site)}
        />
        <link
          rel="alternate"
          hreflang="en"
          href={new URL(localeUrl(route, "en"), Astro.site)}
        />
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(localeUrl(route, "tr"), Astro.site)}
        />
      </>
    )}
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Muse" />
    <meta property="og:title" {...titleMeta} />
    <meta property="og:description" {...descriptionMeta} />
    <meta property="og:locale" content={locale === "tr" ? "tr_TR" : "en_US"} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      {...translatedAttribute("content", "seo.imageAlt", locale)}
    />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" {...titleMeta} />
    <meta name="twitter:description" {...descriptionMeta} />
    <meta name="twitter:image" content={socialImage} />
    <script set:html={languageState} is:inline />
    <script is:inline>
      // Apply the independent theme preference before paint.
      (() => {
        const root = document.documentElement;
        let preference = "system";
        try {
          preference = localStorage.getItem("muse-theme") || "system";
        } catch {}
        if (!["light", "dark", "system"].includes(preference))
          preference = "system";
        const dark =
          preference === "dark" ||
          (preference === "system" &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        root.dataset.theme = dark ? "dark" : "light";
        root.dataset.themePreference = preference;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      <Text k="a11y.skip" />
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <a
          class="wordmark"
          href={localeUrl("", locale)}
          data-route=""
          {...translatedAttribute("aria-label", "a11y.home", locale)}
        >
          Muse
          <span class="wordmark-dot" aria-hidden="true">
            .
          </span>
        </a>
        <nav {...translatedAttribute("aria-label", "a11y.navigation", locale)}>
          {(["home", "software", "about"] as const).map((key) => (
            <a
              href={localeUrl(key === "home" ? "" : `${key}/`, locale)}
              data-route={key === "home" ? "" : `${key}/`}
              aria-current={current === key ? "page" : undefined}
            >
              <Text k={`nav.${key}`} />
            </a>
          ))}
        </nav>
        <div class="header-controls">
          <a
            class="language-toggle"
            id="language-toggle"
            href={localeUrl(noindex ? "" : route, nextLocale)}
            aria-label={translate(locale, "language.action", {
              current: languageNames[locale],
              next: languageNames[nextLocale],
            })}
            title={translate(locale, "language.action", {
              current: languageNames[locale],
              next: languageNames[nextLocale],
            })}
          >
            <Icon name="language" size={19} />
            <span id="language-label">{languageNames[locale]}</span>
          </a>
          <div class="theme-controls" hidden>
            <button
              class="theme-toggle"
              id="theme-toggle"
              type="button"
              aria-label={translate(locale, "theme.action", {
                current: translate(locale, "theme.system"),
                next: translate(locale, "theme.light"),
              })}
            >
              <Icon name="sun" class="theme-sun" size={19} />
              <Icon name="moon" class="theme-moon" size={19} />
              <span id="theme-label">{translate(locale, "theme.system")}</span>
            </button>
          </div>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div>
          <a
            class="wordmark footer-wordmark"
            href={localeUrl("", locale)}
            data-route=""
          >
            Muse
            <span class="wordmark-dot" aria-hidden="true">
              .
            </span>
          </a>
          <Text as="p" k="footer.tagline" />
        </div>
        <Text as="div" class="footer-principle" k="brand.philosophy" />
      </div>
      <div class="container footer-bottom">
        <Text as="p" k="footer.description" />
        <div class="footer-links">
          {source && (
            <a href={source}>
              <Text k="common.source" /> <Icon name="diagonal" size={15} />
            </a>
          )}
          {contact && (
            <a href={contact}>
              <Text k="common.contact" /> <Icon name="diagonal" size={15} />
            </a>
          )}
          <a href={localeUrl("about/", locale)} data-route="about/">
            <Text k="common.aboutMuse" />
          </a>
        </div>
      </div>
    </footer>
    <p
      id="language-status"
      class="visually-hidden"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></p>
    <script
      type="application/json"
      id="muse-translations"
      set:html={json}
      is:inline
    />
    <script set:html={preferences} is:inline />
  </body>
</html>
