---
import type { MuseApp } from "../lib/catalog";
import Text from "./Text.astro";
import { currentLocale, localeUrl, translatedAttribute } from "../i18n/server";
import { withBase } from "../lib/paths";
import Icon from "./Icon.astro";
interface Props {
  app: MuseApp;
}
const { app } = Astro.props;
const locale = currentLocale(Astro.url.pathname);
const date = app.releaseDate
  ? new Intl.DateTimeFormat(locale, {
      dateStyle: "long",
      timeZone: "UTC",
    }).format(new Date(app.releaseDate))
  : undefined;
const targetPlatforms = ["Windows", "Linux"] as const;
---

<div class="container page-content">
  <a
    class="breadcrumb"
    href={localeUrl("software/", locale)}
    data-route="software/"
  >
    <Icon name="back" size={18} />
    <Text k="common.allSoftware" />
  </a>
  <header class="app-detail-header">
    <div class="app-icon">
      {app.icon ? (
        <img src={withBase(app.icon)} alt="" width="72" height="72" />
      ) : (
        <span aria-hidden="true">{app.name.charAt(0)}</span>
      )}
    </div>
    <div>
      <Text class="chip" k={`status.${app.status}`} />
      <h1>{app.name}</h1>
      <Text as="p" value={app.tagline} />
    </div>
  </header>
  <Text as="p" class="detail-description" value={app.description} />
  <section class="detail-section" aria-labelledby="screenshots-heading">
    <Text as="h2" id="screenshots-heading" k="app.screenshots" />
    {app.screenshots?.length ? (
      <div class="screenshot-grid">
        {app.screenshots.map((screenshot) => (
          <figure>
            <a
              href={withBase(screenshot.src)}
              {...translatedAttribute("aria-label", "a11y.screenshot", locale, {
                alt: screenshot.alt,
              })}
            >
              <img
                src={withBase(screenshot.src)}
                alt={screenshot.alt[locale]}
                data-localized-alt={JSON.stringify(screenshot.alt)}
                width={screenshot.width}
                height={screenshot.height}
                loading="lazy"
                decoding="async"
              />
            </a>
            {screenshot.caption && (
              <Text as="figcaption" value={screenshot.caption} />
            )}
          </figure>
        ))}
      </div>
    ) : (
      <div class="media-empty">
        <Icon name="image" />
        <Text as="p" k="app.mediaUnavailable" />
      </div>
    )}
  </section>
  <div class="detail-grid">
    <div>
      {!!app.features?.length && (
        <section class="detail-section" aria-labelledby="features-heading">
          <Text as="h2" id="features-heading" k="app.features" />
          <ul>
            {app.features.map((feature) => (
              <Text as="li" value={feature} />
            ))}
          </ul>
        </section>
      )}
      <section class="detail-section" aria-labelledby="platforms-heading">
        <Text as="h2" id="platforms-heading" k="app.platforms" />
        <Text as="p" k="app.platformDescription" />
        {targetPlatforms.map((platform) => {
          const tested = app.testedPlatforms?.find(
            (item) => item.platform === platform,
          );
          const supported = app.platforms?.includes(platform);
          const built = app.buildVerifiedPlatforms?.includes(platform);
          return (
            <div class="platform-record">
              <strong>{platform}</strong>
              <Text
                as="p"
                k={
                  supported
                    ? "app.supported"
                    : tested
                      ? "app.tested"
                      : built
                        ? "app.built"
                        : "app.unverified"
                }
              />
              {tested && (
                <p>
                  <Text value={tested.environment} />
                  {tested.notes && (
                    <>
                      {" — "}
                      <Text value={tested.notes} />
                    </>
                  )}
                </p>
              )}
            </div>
          );
        })}
        <Text as="p" class="platform-scope-note" k="app.macos" />
      </section>
      {!!app.requirements?.length && (
        <section class="detail-section" aria-labelledby="requirements-heading">
          <Text as="h2" id="requirements-heading" k="app.requirements" />
          <ul>
            {app.requirements.map((item) => (
              <Text as="li" value={item} />
            ))}
          </ul>
        </section>
      )}
      {!!app.installation?.length && (
        <section class="detail-section" aria-labelledby="installation-heading">
          <Text as="h2" id="installation-heading" k="app.installation" />
          <ol>
            {app.installation.map((step) => (
              <Text as="li" value={step} />
            ))}
          </ol>
        </section>
      )}
      {!!app.limitations?.length && (
        <section class="detail-section" aria-labelledby="limitations-heading">
          <Text as="h2" id="limitations-heading" k="app.limitations" />
          <ul>
            {app.limitations.map((item) => (
              <Text as="li" value={item} />
            ))}
          </ul>
        </section>
      )}
    </div>
    <aside
      class="detail-sidebar"
      {...translatedAttribute("aria-label", "a11y.downloads", locale)}
    >
      {(app.version || date) && (
        <section class="detail-section" aria-labelledby="release-heading">
          <Text as="h2" id="release-heading" k="app.release" />
          {app.version && (
            <Text as="p" k="app.version" params={{ version: app.version }} />
          )}
          {date && (
            <p>
              <Text k="app.released" />{" "}
              <time datetime={app.releaseDate} data-date={app.releaseDate}>
                {date}
              </time>
            </p>
          )}
        </section>
      )}
      <section class="detail-section" aria-labelledby="downloads-heading">
        <Text as="h2" id="downloads-heading" k="app.downloads" />
        {app.downloads?.length ? (
          <div class="detail-actions">
            {app.downloads.map((download) => (
              <a class="button button-filled" href={download.url}>
                <Icon name="download" size={18} />
                <Text value={download.label} /> · {download.platform}
                {download.size && ` · ${download.size}`}
              </a>
            ))}
          </div>
        ) : (
          <Text as="p" k="app.downloadsUnavailable" />
        )}
      </section>
      {(app.repositoryUrl ||
        app.releaseUrl ||
        app.documentationUrl ||
        app.issuesUrl) && (
        <section class="detail-section" aria-labelledby="project-links-heading">
          <Text as="h2" id="project-links-heading" k="app.links" />
          <div class="detail-actions">
            {app.repositoryUrl && (
              <a class="text-link" href={app.repositoryUrl}>
                <Text k="app.repository" />
                <Icon name="diagonal" size={18} />
              </a>
            )}
            {app.releaseUrl && (
              <a class="text-link" href={app.releaseUrl}>
                <Text k="app.releaseNotes" />
                <Icon name="diagonal" size={18} />
              </a>
            )}
            {app.documentationUrl && (
              <a class="text-link" href={app.documentationUrl}>
                <Text k="app.documentation" />
                <Icon name="diagonal" size={18} />
              </a>
            )}
            {app.issuesUrl && (
              <a class="text-link" href={app.issuesUrl}>
                <Text k="app.issues" />
                <Icon name="diagonal" size={18} />
              </a>
            )}
          </div>
        </section>
      )}
    </aside>
  </div>
</div>
