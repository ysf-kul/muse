---
import type { MuseApp } from "../lib/catalog";
import { copy } from "../data/site";
import { withBase } from "../lib/paths";
import Icon from "./Icon.astro";
interface Props {
  app: MuseApp;
}
const { app } = Astro.props;
const date = app.releaseDate
  ? new Intl.DateTimeFormat("en", {
      dateStyle: "long",
      timeZone: "UTC",
    }).format(new Date(app.releaseDate))
  : undefined;
const targetPlatforms = ["Windows", "Linux"] as const;
---

<div class="container page-content">
  <a class="breadcrumb" href={withBase("software/")}>
    <Icon name="back" size={18} />
    All software
  </a>
  <header class="app-detail-header">
    <div class="app-icon">
      {app.icon ? (
        <img src={withBase(app.icon)} alt="" width="72" height="72" />
      ) : (
        <span aria-hidden="true">{app.name.charAt(0)}</span>
      )}
    </div>
    <div>
      <span class="chip">{copy.status[app.status]}</span>
      <h1>{app.name}</h1>
      <p>{app.tagline}</p>
    </div>
  </header>
  <p class="detail-description">{app.description}</p>
  <section class="detail-section" aria-labelledby="screenshots-heading">
    <h2 id="screenshots-heading">A closer look</h2>
    {app.screenshots?.length ? (
      <div class="screenshot-grid">
        {app.screenshots.map((screenshot) => (
          <figure>
            <a
              href={withBase(screenshot.src)}
              aria-label={`View full screenshot: ${screenshot.alt}`}
            >
              <img
                src={withBase(screenshot.src)}
                alt={screenshot.alt}
                width={screenshot.width}
                height={screenshot.height}
                loading="lazy"
                decoding="async"
              />
            </a>
            {screenshot.caption && (
              <figcaption>{screenshot.caption}</figcaption>
            )}
          </figure>
        ))}
      </div>
    ) : (
      <div class="media-empty">
        <Icon name="image" />
        <p>{copy.mediaUnavailable}</p>
      </div>
    )}
  </section>
  <div class="detail-grid">
    <div>
      {!!app.features?.length && (
        <section class="detail-section" aria-labelledby="features-heading">
          <h2 id="features-heading">What it does</h2>
          <ul>
            {app.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        </section>
      )}
      <section class="detail-section" aria-labelledby="platforms-heading">
        <h2 id="platforms-heading">Platforms & verification</h2>
        <p>
          Windows and Linux are Muse’s current desktop targets. A build alone
          does not establish runtime compatibility.
        </p>
        {targetPlatforms.map((platform) => {
          const tested = app.testedPlatforms?.find(
            (item) => item.platform === platform,
          );
          const supported = app.platforms?.includes(platform);
          const built = app.buildVerifiedPlatforms?.includes(platform);
          return (
            <div class="platform-record">
              <strong>{platform}</strong>
              <p>
                {supported
                  ? "Supported · Runtime tested"
                  : tested
                    ? "Runtime tested · Support not declared"
                    : built
                      ? "Build verified · Runtime not tested"
                      : "Support not verified"}
              </p>
              {tested && (
                <p>
                  {tested.environment}
                  {tested.notes && ` — ${tested.notes}`}
                </p>
              )}
            </div>
          );
        })}
        <p class="platform-scope-note">
          macOS is not currently supported or tested.
        </p>
      </section>
      {!!app.requirements?.length && (
        <section class="detail-section" aria-labelledby="requirements-heading">
          <h2 id="requirements-heading">Requirements</h2>
          <ul>
            {app.requirements.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )}
      {!!app.installation?.length && (
        <section class="detail-section" aria-labelledby="installation-heading">
          <h2 id="installation-heading">Installation</h2>
          <ol>
            {app.installation.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </section>
      )}
      {!!app.limitations?.length && (
        <section class="detail-section" aria-labelledby="limitations-heading">
          <h2 id="limitations-heading">Known limitations</h2>
          <ul>
            {app.limitations.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )}
    </div>
    <aside
      class="detail-sidebar"
      aria-label="Downloads and project information"
    >
      {(app.version || date) && (
        <section class="detail-section" aria-labelledby="release-heading">
          <h2 id="release-heading">Release information</h2>
          {app.version && <p>Version {app.version}</p>}
          {date && (
            <p>
              Released <time datetime={app.releaseDate}>{date}</time>
            </p>
          )}
        </section>
      )}
      <section class="detail-section" aria-labelledby="downloads-heading">
        <h2 id="downloads-heading">Downloads</h2>
        {app.downloads?.length ? (
          <div class="detail-actions">
            {app.downloads.map((download) => (
              <a class="button button-filled" href={download.url}>
                <Icon name="download" size={18} />
                {download.label} · {download.platform}
                {download.size && ` · ${download.size}`}
              </a>
            ))}
          </div>
        ) : (
          <p>{copy.downloadsUnavailable}</p>
        )}
      </section>
      {(app.repositoryUrl || app.documentationUrl || app.issuesUrl) && (
        <section class="detail-section" aria-labelledby="project-links-heading">
          <h2 id="project-links-heading">Project links</h2>
          <div class="detail-actions">
            {app.repositoryUrl && (
              <a class="text-link" href={app.repositoryUrl}>
                Source repository
                <Icon name="diagonal" size={18} />
              </a>
            )}
            {app.documentationUrl && (
              <a class="text-link" href={app.documentationUrl}>
                Documentation
                <Icon name="diagonal" size={18} />
              </a>
            )}
            {app.issuesUrl && (
              <a class="text-link" href={app.issuesUrl}>
                Report an issue
                <Icon name="diagonal" size={18} />
              </a>
            )}
          </div>
        </section>
      )}
    </aside>
  </div>
</div>
