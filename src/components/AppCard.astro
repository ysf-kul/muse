---
import type { MuseApp } from "../lib/catalog";
import Text from "./Text.astro";
import { currentLocale, localeUrl } from "../i18n/server";
import { withBase } from "../lib/paths";
import Icon from "./Icon.astro";
interface Props {
  app: MuseApp;
}
const { app } = Astro.props;
const locale = currentLocale(Astro.url.pathname);
---

<article class="app-card">
  <div class="app-card-top">
    <div class="app-icon">
      {app.icon ? (
        <img
          src={withBase(app.icon)}
          alt=""
          width="56"
          height="56"
          loading="lazy"
        />
      ) : (
        <span aria-hidden="true">{app.name.charAt(0)}</span>
      )}
    </div>
    <Text class="chip" k={`status.${app.status}`} />
  </div>
  <h3>
    <a
      href={localeUrl(`software/${app.id}/`, locale)}
      data-route={`software/${app.id}/`}
    >
      {app.name}
    </a>
  </h3>
  <Text as="p" value={app.tagline} />
  <div class="platform-chips">
    {app.platforms?.map((platform) => (
      <span class="chip">
        <Icon name="monitor" size={15} />
        {platform}
      </span>
    ))}
  </div>
  <a
    class="text-link"
    href={localeUrl(`software/${app.id}/`, locale)}
    data-route={`software/${app.id}/`}
  >
    <Text k="common.exploreApp" params={{ name: app.name }} />
    <Icon name="arrow" size={19} />
  </a>
</article>
