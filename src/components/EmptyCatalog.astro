---
import Icon from "./Icon.astro";
import Text from "./Text.astro";
import { currentLocale, localeUrl } from "../i18n/server";
const locale = currentLocale(Astro.url.pathname);
interface Props {
  headingLevel?: "h2" | "h3";
}
const Heading = Astro.props.headingLevel ?? "h3";
---

<div class="empty-catalog">
  <div class="empty-icon">
    <Icon name="grid" size={30} />
  </div>
  <div class="empty-content">
    <Text as="p" class="eyebrow" k="catalog.emptyLabel" />
    <Text as={Heading} k="catalog.emptyTitle" />
    <Text as="p" k="catalog.emptyDescription" />
    <a class="text-link" href={localeUrl("about/", locale)} data-route="about/">
      <Text k="catalog.about" /> <Icon name="arrow" size={19} />
    </a>
  </div>
</div>
